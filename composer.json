{
    "name": "marclang64/kern",
    "description": "a lightweight PHP microframework",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "nyholm/psr7": "^1.8",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1"
    },
    "require-dev": {
        "marclang64/backend-tooling": "1.3.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/marclang64/backend-tooling"
        }
    ],
    "scripts": {
        "lint:style": "php-cs-fixer fix --dry-run --diff",
        "fix:style": "php-cs-fixer fix",
        "lint:types": "phpstan analyse --no-progress",
        "test": "phpunit",
        "lint:rector": "rector process --dry-run",
        "fix:rector": "rector process"
    },
    "autoload": {
        "psr-4": {
            "Kern\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kern\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

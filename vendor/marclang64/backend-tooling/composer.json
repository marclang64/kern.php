{
    "name": "marclang64/backend-tooling",
    "description": "Reusable tooling configurations for modern PHP development",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "symfony/process": "^8.1"
    },
    "scripts": {
        "lint:style": "php-cs-fixer fix --dry-run --diff",
        "fix:style": "php-cs-fixer fix",
        "lint:types": "phpstan analyse --no-progress",
        "test": "phpunit"
    }
}
